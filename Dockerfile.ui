# ---- rag-ui image (Streamlit) ----
# Light: the UI talks to rag-api over HTTP (RAG_API_URL), so it needs only
# streamlit + requests — none of the torch/crawl4ai weight. Binds to $PORT.
FROM python:3.12-slim

WORKDIR /app
ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir "streamlit>=1.40" "requests>=2.31"

COPY ui ./ui

EXPOSE 8501
CMD ["sh", "-c", "streamlit run ui/streamlit_app.py \
    --server.port ${PORT:-8501} --server.address 0.0.0.0 \
    --server.headless true --server.enableCORS false \
    --server.enableXsrfProtection false --browser.gatherUsageStats false"]
